# The workspace repository tracks only its own files. Every repository folder is ignored,
# so new ones need no entry here and are never added as embedded repositories.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/workspace.json
!/.claude/
!/.ai/

# Personal Claude Code settings stay on each machine; the shared ones are in .claude/settings.json.
/.claude/settings.local.json

__pycache__/
*.pyc
.DS_Store

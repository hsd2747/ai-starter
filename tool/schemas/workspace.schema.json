{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-starter/workspace.schema.json",
  "title": "Workspace manifest (workspace.json)",
  "type": "object",
  "required": ["schemaVersion", "starter", "repos"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "starter": { "$ref": "#/$defs/starter" },
    "repos": { "type": "array", "items": { "$ref": "#/$defs/repo" } }
  },
  "$defs": {
    "starter": {
      "type": "object",
      "required": ["commit", "dirty"],
      "additionalProperties": false,
      "properties": {
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "repo": {
      "type": "object",
      "required": ["name", "path"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "path": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "kind": { "enum": ["managed", "registered"], "description": "Written by older versions and ignored: the repository's .ai/harness.json decides." },
        "remote": { "type": "string" }
      }
    }
  }
}
